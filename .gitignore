# ==============================================================================
# Tahira Syndicate — Master Production .gitignore
# ==============================================================================

# Node dependencies (Never upload to GitHub)
node_modules/
.pnpm/
pnpm-store/

# Next.js build output & static export cache
.next/
out/
build/
dist/

# TypeScript build info cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# All Environment variables & secrets (Never upload any .env files)
.env*

# Internal AI documentation & local tooling scripts
AGENTS.md
scripts/

# Archived/Deleted media preservation folder
public/unused_media/

# OS, Editor & IDE temporary files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Debug and runtime logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*