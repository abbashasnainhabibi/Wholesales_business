generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  Active
  Draft
}

enum AttributeType {
  Select       @map("select")
  MultiSelect  @map("multi-select")
  Number       @map("number")
  Text         @map("text")
}

enum SeoStatus {
  Complete
  NeedsReview @map("Needs Review")
}

enum ProductAvailability {
  InStock     @map("In Stock")
  OutOfStock  @map("Out of Stock")
}

enum ReviewStatus {
  Pending
  Approved
  Rejected
}

model User {
  id            String    @id @default(cuid())
  name          String?   @db.VarChar(180)
  email         String    @unique @db.VarChar(255)
  emailVerified DateTime?
  image         String?   @db.VarChar(500)
  passwordHash  String    @db.VarChar(255)
  role          UserRole  @default(Admin)
  accounts      Account[]
  sessions      Session[]
  loginAttempts LoginAttempt[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("user")
}

enum UserRole {
  Admin
  User
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("account")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
  @@map("verificationtoken")
}

model LoginAttempt {
  id         Int      @id @default(autoincrement())
  email      String   @db.VarChar(255)
  ipAddress  String   @db.VarChar(64)
  failedAt   DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([email, failedAt])
  @@index([ipAddress, failedAt])
  @@map("loginattempt")
}

model Category {
  id              Int                 @id @default(autoincrement())
  name            String              @db.VarChar(160)
  slug            String              @unique @db.VarChar(180)
  image           String?             @db.Text
  status          RecordStatus        @default(Active)
  metaTitle       String              @db.VarChar(255)
  metaDescription String              @db.VarChar(320)
  description     String              @db.Text
  attributes      CategoryAttribute[]
  products        Product[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("category")
}

model Attribute {
  id          Int                 @id @default(autoincrement())
  name        String              @db.VarChar(120)
  type        AttributeType
  options     Json
  status      RecordStatus        @default(Active)
  required    Boolean             @default(false)
  categories  CategoryAttribute[]
  values      ProductAttributeValue[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("attribute")
}

model CategoryAttribute {
  categoryId  Int
  attributeId Int
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  sortOrder   Int       @default(0)

  @@id([categoryId, attributeId])
  @@index([attributeId])
  @@map("categoryattribute")
}

model Product {
  id                Int                    @id @default(autoincrement())
  name              String                 @db.VarChar(200)
  sku               String                 @unique @db.VarChar(100)
  categoryId        Int
  price             Decimal                @db.Decimal(12, 2)
  availability      ProductAvailability    @default(InStock)
  status            RecordStatus           @default(Draft)
  seoStatus         SeoStatus              @default(NeedsReview)
  metaTitle         String                 @db.VarChar(255)
  metaDescription   String                 @db.VarChar(320)
  slug              String                 @unique @db.VarChar(220)
  barcode           String?                @unique @db.VarChar(64)
  moq               Int                    @default(1)
  bulkPricing       Json
  weight            Decimal?               @db.Decimal(10, 3)
  length            Decimal?               @db.Decimal(10, 3)
  width             Decimal?               @db.Decimal(10, 3)
  height            Decimal?               @db.Decimal(10, 3)
  countryOfOrigin   String?                @db.VarChar(120)
  relatedProductIds Json
  ogTitle           String?                @db.VarChar(255)
  ogDescription     String?                @db.VarChar(320)
  ogImage           String?                @db.VarChar(1000)
  usage             String                 @db.Text
  shortDescription  String                 @default("") @db.VarChar(500)
  longDescription   String?                @db.Text
  tradeAliases      String?                @db.VarChar(500)
  benefits          Json
  suitedFor         Json
  notSuitedFor      Json
  category          Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images            ProductImage[]
  faqs              ProductFaq[]
  attributeValues   ProductAttributeValue[]
  reviews           Review[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([categoryId])
  @@index([availability])
  @@index([seoStatus])
  @@map("product")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  src       String   @db.VarChar(1000)
  alt       String   @db.VarChar(255)
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("productimage")
}

model ProductFaq {
  id        Int      @id @default(autoincrement())
  productId Int
  question  String   @db.VarChar(500)
  answer    String   @db.Text
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("productfaq")
}

model ProductAttributeValue {
  id          Int       @id @default(autoincrement())
  productId   Int
  attributeId Int
  value       String    @db.VarChar(500)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([attributeId])
  @@map("productattributevalue")
}

model CompanySettings {
  id        Int      @id @default(1)
  name      String   @db.VarChar(180)
  tagline   String   @db.VarChar(255)
  description String @db.Text
  address   String   @db.Text
  phone     String   @db.VarChar(40)
  whatsapp  String   @db.VarChar(40)
  email     String   @db.VarChar(255)
  facebook  String   @db.VarChar(500)
  instagram String   @db.VarChar(500)
  hours     String   @db.VarChar(255)
  updatedAt DateTime @updatedAt

  @@map("companysettings")
}

model SeoSettings {
  id                Int      @id @default(1)
  titleTemplate     String   @db.VarChar(255)
  metaDescription   String   @db.VarChar(320)
  ogImage           String   @db.VarChar(1000)
  verificationNotes String   @db.Text
  updatedAt         DateTime @updatedAt

  @@map("seosettings")
}

model Review {
  id        Int          @id @default(autoincrement())
  name      String       @db.VarChar(180)
  rating    Int          @default(5)
  message   String       @db.Text
  contact   String?      @db.VarChar(255)
  imageUrl  String?      @db.VarChar(1000)
  status    ReviewStatus @default(Pending)
  productId Int?
  serviceId String?      @db.VarChar(100)
  product   Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
  @@index([productId])
  @@index([serviceId])
  @@index([createdAt])
  @@map("review")
}

